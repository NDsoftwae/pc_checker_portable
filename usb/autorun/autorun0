#!/bin/bash
# PC Hardware Test - started automatically by SystemRescue at boot.
# SystemRescue runs every "autorunN" script found in the "autorun" folder of the USB stick.

SRC=""
if [ -f /run/archiso/bootmnt/pctest/pctest.py ]; then
    SRC=/run/archiso/bootmnt/pctest
else
    # Boot device not mounted (e.g. "copy to RAM" boot): find the stick ourselves.
    mkdir -p /mnt/pctest_src
    for dev in $(lsblk -lnpo NAME,FSTYPE | awk '$2 ~ /^(vfat|exfat|iso9660|ntfs)$/ {print $1}'); do
        if mount -o ro "$dev" /mnt/pctest_src 2>/dev/null; then
            if [ -f /mnt/pctest_src/pctest/pctest.py ]; then
                SRC=/mnt/pctest_src/pctest
                break
            fi
            umount /mnt/pctest_src
        fi
    done
fi

if [ -z "$SRC" ]; then
    echo "PC Hardware Test: pctest/pctest.py was not found on the USB stick."
    exit 1
fi

# 'pctest' command to run the test again from the shell
cat > /usr/local/bin/pctest <<EOF
#!/bin/bash
exec python3 "$SRC/pctest.py" "\$@"
EOF
chmod +x /usr/local/bin/pctest

# keep the console awake during long tests
setterm --blank 0 --powerdown 0 2>/dev/null

python3 "$SRC/pctest.py"
exit 0
